{
  "name": "HIMAL Video Player Dev",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/flutter:1": {
      "version": "stable"
    }
  },
  "postCreateCommand": "flutter pub get && flutter create --project-name himal_video_player --platforms=android,ios,linux,macos,windows,web .",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ]
    }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "HIMAL Web",
      "onAutoForward": "notify"
    }
  }
}